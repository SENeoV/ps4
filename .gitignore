__pycache__/
*.pyc

# Ningun PKG entra en el repo, este donde este (pesan cientos de MB / GBs)
*.pkg
# Instaladores de Windows (pkg/win/)
*.exe
# Payloads para Payload Guest (pkg/payloads/): binarios, catalogados en catalogo/PKG/payloads/
pkg/payloads/**/*.bin

# Comprimidos descargados (packs de ROMs, covers...) en cualquier ubicacion
*.rar
*.7z
*.zip

# emu/: se versiona la estructura y la documentación, nunca el contenido.
# ROMs, BIOS y PKGs viven solo en local y en la copia que va a la PS4.
# (GitHub rechaza archivos >100 MB, y un PKG de RetroArch los supera.)
emu/**
!emu/**/
!emu/**/*.md
!emu/RETROARCH/info/*.info
!emu/RETROARCH/playlists/*.lpl
# Juegos de DOS y ScummVM descomprimidos: todo lo de dentro es del juego (hay archivos de datos con extensión .MD)
emu/ROMS/DOS/*/**
emu/ROMS/SCUMMVM/*/**
# Assets del menú de RetroArch, copiados de retroarch-assets: sus README.md son de libretro, no documentación nuestra
emu/RETROARCH/assets/**

# linux/: igual que emu/. Loader, kernel, initramfs y distros viven solo en local y se catalogan
# en catalogo/LINUX/. Los repos de linux/src/ son submódulos (solo se versiona el commit).
linux/**
!linux/**/
!linux/**/*.md
!linux/pkgs/*.sh
# ps4-cpu: script, iconos SVG, lanzadores e instalador (texto, se versiona todo)
!linux/cpu/*
# escritorio: lanzadores .desktop e instalador (texto)
!linux/escritorio/*
