#!/usr/bin/env python3
# ps4-cpu: cambia la frecuencia de la CPU de la PS4 en Linux (Jaguar, familia 16h) escribiendo el P-state por MSR.
# El kernel 5.4 de Baikal no lleva cpufreq y deja la CPU en P2 (1,6 GHz); P0 (2,1 GHz) está permitido y da
# velocidad completa en Dolphin. Ver linux/cpu/README.md.
#
#   ps4-cpu rendimiento   -> P0, 2,1 GHz
#   ps4-cpu normal        -> P2, 1,6 GHz (lo que deja el arranque)
#   ps4-cpu alternar      -> cambia de uno a otro
#   ps4-cpu estado        -> solo informa
#
# La parte que toca los MSR se ejecuta como root (sudo sin clave, ver instalar.sh); el aviso en pantalla, como usuario.

import json
import os
import struct
import subprocess
import sys

MODOS = {"rendimiento": 0, "normal": 2}
NOMBRE = {0: "Modo rendimiento", 2: "Modo normal"}
PSTATE_CTL, PSTATE_STATUS, PSTATE_DEF = 0xC0010062, 0xC0010063, 0xC0010064
NUCLEOS = 8
AQUI = os.path.dirname(os.path.abspath(__file__))
ICONOS = "/usr/local/share/ps4-cpu"


def msr_leer(cpu, reg):
    f = os.open(f"/dev/cpu/{cpu}/msr", os.O_RDONLY)
    os.lseek(f, reg, 0)
    v = struct.unpack("<Q", os.read(f, 8))[0]
    os.close(f)
    return v


def msr_escribir(cpu, reg, val):
    f = os.open(f"/dev/cpu/{cpu}/msr", os.O_WRONLY)
    os.lseek(f, reg, 0)
    os.write(f, struct.pack("<Q", val))
    os.close(f)


def mhz(pstate):
    # CoreCOF = 100 MHz * (CpuFid + 0x10) / 2^CpuDid
    v = msr_leer(0, PSTATE_DEF + pstate)
    return int(100 * ((v & 0x3F) + 0x10) / (2 ** ((v >> 6) & 7)))


def parte_root(pedido):
    """Solo root: aplica el P-state si se pide uno y devuelve el estado en JSON."""
    actual = msr_leer(0, PSTATE_STATUS) & 7
    if pedido == "alternar":
        pedido = 2 if actual == 0 else 0
    if pedido is not None and pedido != "estado":
        for c in range(NUCLEOS):
            msr_escribir(c, PSTATE_CTL, int(pedido))
    estados = [msr_leer(c, PSTATE_STATUS) & 7 for c in range(NUCLEOS)]
    p = max(set(estados), key=estados.count)
    print(json.dumps({"pstate": p, "mhz": mhz(p), "nucleos": estados}))


def temperatura():
    import glob
    for f in glob.glob("/sys/class/hwmon/hwmon*/temp1_input"):
        try:
            return int(open(f).read()) / 1000
        except OSError:
            pass
    return None


def aviso(titulo, texto, icono):
    """Ventanita arriba a la derecha que se cierra sola. Si no hay pantalla o GTK, no pasa nada."""
    if not os.environ.get("DISPLAY"):
        return
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, GLib, Gdk
    except Exception:
        return
    w = Gtk.Window(type=Gtk.WindowType.POPUP)
    w.set_keep_above(True)
    caja = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
    caja.set_border_width(14)
    if os.path.exists(icono):
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file_at_size(icono, 56, 56)
        caja.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
    textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    t = Gtk.Label(xalign=0); t.set_markup(f"<span size='x-large' weight='bold'>{titulo}</span>")
    s = Gtk.Label(xalign=0); s.set_markup(f"<span size='large'>{texto}</span>")
    textos.pack_start(t, False, False, 0); textos.pack_start(s, False, False, 0)
    caja.pack_start(textos, False, False, 0)
    w.add(caja)
    css = Gtk.CssProvider()
    css.load_from_data(b"window { background: rgba(20,20,24,0.94); color: #fff; border-radius: 12px; border: 1px solid #555; }")
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    w.show_all()
    ancho = w.get_size()[0]
    pantalla = Gdk.Display.get_default().get_primary_monitor().get_geometry().width
    w.move(pantalla - ancho - 24, 40)
    GLib.timeout_add(2800, Gtk.main_quit)
    Gtk.main()


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "--msr":
        return parte_root(sys.argv[2] if len(sys.argv) > 2 else "estado")
    modo = sys.argv[1] if len(sys.argv) > 1 else "estado"
    if modo not in ("rendimiento", "normal", "alternar", "estado"):
        sys.exit("uso: ps4-cpu rendimiento|normal|alternar|estado")
    pedido = str(MODOS.get(modo, modo))
    # Se llama a sí mismo por su ruta (no "python3 ruta"): la regla de sudoers sin clave es para esa ruta exacta
    cmd = [os.path.abspath(__file__), "--msr", pedido]
    if os.geteuid() != 0:
        cmd = ["sudo", "-n"] + cmd
    try:
        salida = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
    except subprocess.CalledProcessError as e:
        sys.exit(f"ps4-cpu: no se pudo leer o escribir el MSR ({e.stderr.strip()}). ¿Está instalado con instalar.sh?")
    est = json.loads(salida)
    temp = temperatura()
    p, f = est["pstate"], est["mhz"]
    nombre = NOMBRE.get(p, f"P{p}")
    detalle = f"CPU a {f/1000:.1f} GHz".replace(".", ",") + (f"  ·  {temp:.0f} °C" if temp else "")
    if len(set(est["nucleos"])) > 1:
        detalle += "  (núcleos desiguales: " + " ".join(f"P{x}" for x in est["nucleos"]) + ")"
    print(f"{nombre}: {detalle}")
    aviso(nombre, detalle, f"{ICONOS}/{'rendimiento' if p == 0 else 'normal'}.svg")


if __name__ == "__main__":
    main()
